# Docker Compose settings (copy to .env on the server; never commit .env).

# Public hostname. Must have a DNS A record pointing to the server's public IP.
# No domain yet? Use <your-ip-with-dashes>.sslip.io, e.g. 13-201-45-67.sslip.io
DOMAIN=portal.example.com

# Generate each with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
