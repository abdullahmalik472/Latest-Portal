{
  "name": "orgportal-supabase-app",
  "version": "1.0.0",
  "private": true,
  "description": "OrgPortal API backed by Supabase (Postgres)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "typecheck": "tsc",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings src database scripts",
    "check": "npm run lint && npm run typecheck && node scripts/check-imports.ts",
    "worker": "node src/worker.js",
    "db:migrate": "node database/migrate.js up",
    "db:migrate:status": "node database/migrate.js status",
    "db:reset": "node database/migrate.js reset",
    "db:seed": "node database/seeds/demo.js",
    "job:report": "node src/jobs/run.js registration-report",
    "job:cleanup-sessions": "node src/jobs/run.js cleanup-sessions"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "node-cron": "^4.2.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "oxlint": "^1.94.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
}
