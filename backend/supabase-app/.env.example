# ---------- server ----------
NODE_ENV=development
# Bind to loopback: only the Next.js proxy and the mysql-app worker (same machine) reach the API.
HOST=127.0.0.1
PORT=4002
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=loopback

# ---------- Supabase ----------
# Dashboard -> Project Settings -> API. The service-role key is a SERVER SECRET:
# never put it in the frontend, never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:migrate` / `db:reset` (schema migrations). Dashboard -> Connect -> "Direct connection"
# (or "Session pooler" on IPv4-only networks). Contains the DB password: server secret.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# Optional: path to the Supabase CA certificate (Dashboard -> Database settings -> SSL) to verify the server.
SUPABASE_DB_SSL_CA=

# ---------- auth ----------
COOKIE_NAME=op_sid
COOKIE_PATH=/api/supabase
# COOKIE_SECURE=true
SESSION_TTL_HOURS=8
BCRYPT_ROUNDS=12
ADMIN_SIGNUP_CODE=change-this-admin-code

# ---------- cron (worker process: npm run worker) ----------
CRON_TIMEZONE=UTC
REPORT_CRON=0 * * * *
SESSION_CLEANUP_CRON=30 3 * * *

# ---------- one-way user migration MySQL -> Supabase (receiver side) ----------
# Must equal MIGRATION_TOKEN in mysql-app. Leave empty to disable the internal import endpoint.
MIGRATION_TOKEN=
