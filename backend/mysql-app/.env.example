# ---------- server ----------
NODE_ENV=development
# Bind to loopback: only the Next.js proxy (same machine) should reach the API.
HOST=127.0.0.1
PORT=4001
# Origins allowed to send state-changing requests (CSRF guard). Comma separated.
ALLOWED_ORIGINS=http://localhost:3000
# Express "trust proxy" setting. "loopback" = trust X-Forwarded-For only from the local Next.js proxy.
TRUST_PROXY=loopback

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=orgportal
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=orgportal

# ---------- auth ----------
# Cookie is scoped to the proxy path so it is only ever sent to this backend.
COOKIE_NAME=op_sid
COOKIE_PATH=/api/mysql
# Defaults to true when NODE_ENV=production. Must be true behind HTTPS.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=8
BCRYPT_ROUNDS=12
# Required to self-register as an admin. Use a long random value in production.
ADMIN_SIGNUP_CODE=change-this-admin-code

# ---------- cron (worker process: npm run worker) ----------
CRON_TIMEZONE=UTC
# Registration report snapshot: every hour
REPORT_CRON=0 * * * *
# Delete expired sessions: daily 03:30
SESSION_CLEANUP_CRON=30 3 * * *

# ---------- one-way user migration MySQL -> Supabase ----------
MIGRATION_ENABLED=false
MIGRATION_CRON=*/15 * * * *
MIGRATION_BATCH_SIZE=100
# Base URL of the supabase-app (internal network; use https outside localhost)
SUPABASE_APP_URL=http://127.0.0.1:4002
# Shared secret, must equal MIGRATION_TOKEN in supabase-app (min 32 chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MIGRATION_TOKEN=
